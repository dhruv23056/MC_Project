<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity"
    android:background="@drawable/gradient_background">

    <!-- Latitude TextView -->
    <TextView
        android:id="@+id/latitudeTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Latitude: "
        android:textColor="#FFFFFF"
        android:textColorHint="#FFFFFF"
        android:textStyle="bold" />

    <!-- Longitude TextView -->
    <TextView
        android:id="@+id/longitudeTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/latitudeTextView"
        android:layout_marginTop="25dp"
        android:text="Longitude: "
        android:textColor="#FFFFFF"
        android:textColorHint="#FFFFFF"
        android:textStyle="bold"/>

    <!-- Route ID TextView -->
    <TextView
        android:id="@+id/routeIdTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/longitudeTextView"
        android:layout_marginTop="25dp"
        android:text="Route ID: "
        android:textColor="#FFFFFF"
        android:textColorHint="#FFFFFF"
        android:textStyle="bold"/>

    <!-- Start Station TextView -->
    <TextView
        android:id="@+id/startstation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/routeIdTextView"
        android:layout_marginTop="25dp"
        android:text="Start Station: "
        android:textColor="#80D8FF"
        android:textColorHint="#80D8FF"
        android:textStyle="bold" />

    <!-- Start Station Spinner -->
    <Spinner
        android:id="@+id/startStationSpinner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/startstation"
        android:layout_marginTop="10dp"
        android:minHeight="48dp"
        android:textStyle="bold"
        android:background="@drawable/spinner_border" />


    <!-- Destination Station TextView -->
    <TextView
        android:id="@+id/destinationstation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/startStationSpinner"
        android:layout_marginTop="15dp"
        android:text="Destination Station: "
        android:textColor="#80D8FF"
        android:textColorHint="#80D8FF"
        android:textStyle="bold" />

    <!-- Destination Station Spinner -->
    <Spinner
        android:id="@+id/destinationStationSpinner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/destinationstation"
        android:layout_marginTop="10dp"
        android:minHeight="48dp"
        android:textStyle="bold"
        android:background="@drawable/spinner_border" />


    <!-- ScrollView for routesContainer -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="254dp"
        android:layout_below="@id/destinationStationSpinner"
        android:layout_marginTop="15dp">

        <LinearLayout
            android:id="@+id/routesContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:textColor="#FFFFFF"
            android:textStyle="bold">

            <!-- Add routes dynamically here -->

        </LinearLayout>
    </ScrollView>

    <!-- Container for Next and GMap buttons -->
    <RelativeLayout
        android:id="@+id/buttons_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="16dp">

        <!-- Get Location Button -->
        <Button
            android:id="@+id/getLocationButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="16dp"
            android:layout_marginBottom="16dp"
            android:backgroundTint="#FFFFFF"
            android:drawableLeft="@drawable/ic_location"
            android:onClick="getLocation"
            android:padding="12dp"
            android:text="Get Location"
            android:textColor="#000000" />

        <!-- GMap Button -->
        <Button
            android:id="@+id/gmapButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_alignParentBottom="true"
            android:layout_marginBottom="16dp"
            android:backgroundTint="#FFFFFF"
            android:drawableLeft="@drawable/ic_map"
            android:onClick="onGMapButtonClick"
            android:padding="12dp"
            android:text="GMap"
            android:textColor="#000000" />

        <!-- Next Button -->
        <Button
            android:id="@+id/nextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            android:backgroundTint="#FFFFFF"
            android:drawableRight="@drawable/ic_next"
            android:onClick="onNextButtonClick"
            android:padding="12dp"
            android:text="Next"
            android:textColor="#000000" />

    </RelativeLayout>

</RelativeLayout>
